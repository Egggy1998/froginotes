{
  "name": "froginotes-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "test": "bun test tests/",
    "test:watch": "bun test --watch tests/",
    "db:migrate": "wrangler d1 execute froginotes-db --local --file=schema.sql",
    "db:seed": "wrangler d1 execute froginotes-db --local --file=seed.sql"
  },
  "dependencies": {
    "@gpmpay/sdk": "^0.4.0",
    "hono": "^4.6.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "wrangler": "^3.80.0",
    "typescript": "^5.6.3"
  }
}
